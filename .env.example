# ============================================================================
# RISKCART AI — ENVIRONMENT VARIABLES TEMPLATE (PUBLIC GITHUB SAFE)
# ============================================================================
# Copy this file to `.env` (which is ignored by `.gitignore`) and fill in your
# environment variables. Never commit real API keys or secrets to Git.
# ============================================================================

# --- 0. Firebase Client & Database Configuration (VITE_FIREBASE_*) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# --- 1. AI Intelligence (Server-Side Gemini API) ---
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- 2. Owner & Supervisor Security Credentials (Server-Side Only — NEVER prefix secrets with VITE_) ---
# OWNER_AUTH_PASSWORD=
# OWNER_PIN=
# PIN_SALT=
# OTP_HMAC_SECRET=

# --- 3. WhatsApp OTP & Notification Gateway (Fonnte Server-Side) ---
# FONNTE_TOKEN=

# --- 4. Payment Gateways (Server-Side Secret Keys) ---
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# DOKU_CLIENT_ID=
# DOKU_SECRET_KEY=
# XENDIT_SECRET_KEY=

# --- 5. Google Apps Script & Google Drive Receipt / Evidence Sync (Server-Side) ---
# GOOGLE_APPS_SCRIPT_WEBHOOK_URL=
# GOOGLE_DRIVE_WEBHOOK_URL=
# GOOGLE_DRIVE_FOLDER_ID=

# --- 6. Cloud SQL (PostgreSQL via Auth Proxy) ---
# SQL_HOST=
# SQL_DB_NAME=
# SQL_USER=
# SQL_PASSWORD=
# SQL_ADMIN_USER=
# SQL_ADMIN_PASSWORD=
