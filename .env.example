# ============================================================================
# RISKCART AI — ENVIRONMENT VARIABLES TEMPLATE (PUBLIC GITHUB SAFE)
# ============================================================================
# IMPORTANT FOR GOOGLE AI STUDIO:
# Keep all variables below commented out with `#` in `.env.example` so AI Studio
# Preview starts immediately without triggering the blocking popup:
# "Enter your environment variable to continue".
#
# For local development or production deployment outside AI Studio, copy this
# file to `.env` (which is ignored by `.gitignore`) and uncomment the keys you need.
# Note: Firebase client configuration is loaded from `firebase-applet-config.json`.
# ============================================================================

# --- 1. AI Intelligence (Server-Side Gemini API) ---
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# --- 2. Owner & Supervisor Security Credentials (Server-Side Only — NEVER prefix secrets with VITE_) ---
# OWNER_AUTH_PASSWORD=your_owner_master_password_here
# OWNER_PIN=your_owner_pin_here
# PIN_SALT=your_random_pin_salt_here
# OTP_HMAC_SECRET=your_random_otp_hmac_secret_here

# --- 3. WhatsApp OTP & Notification Gateway (Fonnte Server-Side) ---
# FONNTE_TOKEN=your_fonnte_api_token_here
# VISITOR_WA_TARGET=your_whatsapp_number_here

# --- 4. Payment Gateways (Server-Side Secret Keys) ---
# MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
# MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
# DOKU_CLIENT_ID=your_doku_client_id_here
# DOKU_SECRET_KEY=your_doku_shared_secret_key_here
# XENDIT_SECRET_KEY=your_xendit_secret_key_here

# --- 5. Google Apps Script & Google Drive Receipt / Evidence Sync (Server-Side) ---
# GOOGLE_APPS_SCRIPT_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
# GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id/exec
# GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# --- 6. Cloud SQL (PostgreSQL via Auth Proxy) ---
# SQL_HOST=/cloudsql/project:region:instance
# SQL_DB_NAME=postgres
# SQL_USER=app_user
# SQL_PASSWORD=your_sql_password_here
# SQL_ADMIN_USER=postgres
# SQL_ADMIN_PASSWORD=your_sql_admin_password_here
