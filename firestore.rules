rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Safe role helper (checks map key existence first to prevent CEL evaluation errors)
    function getUserRole() {
      return !isSignedIn() ? ''
        : ('role' in request.auth.token && request.auth.token.role is string)
          ? request.auth.token.role
          : '';
    }

    function isOwnerOrAdmin() {
      return (isSignedIn() && 'email' in request.auth.token && request.auth.token.email == 'panglimabesarisis@gmail.com')
        || getUserRole() in ['owner', 'admin', 'Owner / Super Admin', 'super_admin', 'OWNER', 'DEMO'];
    }

    function isStaff() {
      return isOwnerOrAdmin() || (isSignedIn() && getUserRole() != '' && getUserRole() != 'customer');
    }

    // Izinkan akses operasional penuh bagi aplikasi POS, Admin Dashboard, Reservasi, Table Layout, dan Client PWA
    function isAppClientOrStaff() {
      return request.auth == null || isSignedIn() || isStaff();
    }

    // Koleksi rahasia yang HANYA boleh diakses Firebase Admin SDK di server
    function serverOnly(c) {
      return c in ['otp_sessions', 'ai_agents_private', 'payment_gateway_secrets'];
    }

    match /otp_sessions/{phone} {
      allow read, write: if false;
    }
    match /ai_agents_private/{agentId} {
      allow read, write: if false;
    }
    match /payment_gateway_secrets/{p} {
      allow read, write: if false;
    }

    // Pengaturan (melindungi dokumen rahasia payment_gateway_secrets)
    match /settings/{docId} {
      allow read: if isAppClientOrStaff() && docId != 'payment_gateway_secrets';
      allow write: if isAppClientOrStaff() && docId != 'payment_gateway_secrets';
    }

    // Koleksi Table Layout, Denah Meja, Reservasi & Riwayat Dine-In
    match /restaurant_tables/{tableId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /tables/{tableId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /table_layouts/{layoutId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /table_reservations/{resId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /reservations/{resId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /table_dinein_history/{recId} {
      allow read, write: if isAppClientOrStaff();
    }

    // Koleksi Katalog Produk, Bahan Baku (BOM), Pembelian & Gudang
    match /products/{productId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /raw_materials/{rmId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /bahan_baku/{rmId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /raw_material_suppliers/{supId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /raw_material_purchase_orders/{poId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /raw_material_purchase_requests/{prId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /raw_material_movements/{movId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /purchase_orders/{poId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /procurements/{procId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /stock_movements/{movId} {
      allow read, write: if isAppClientOrStaff();
    }

    // Koleksi Transaksi POS, Pesanan Online, Kas, Shift & Brangkas
    match /transactions/{txId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /orders/{orderId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /pos_orders/{orderId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /shifts/{shiftId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /shift_history/{shiftId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /cashier_shifts/{shiftId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /cash_logs/{logId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /cash_flows/{flowId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /cash_mutations/{mutId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /pos_incomes/{incId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /incomes/{incId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /expenses/{expId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /brangkas_toko_logs/{logId} {
      allow read, write: if isAppClientOrStaff();
    }
    match /safe_deposits/{depId} {
      allow read, write: if isAppClientOrStaff();
    }

    // Data per toko: stores/store_001/{products|restaurant_tables|table_reservations|transactions|orders|settings|...}
    match /stores/{storeId}/{sub}/{docId} {
      allow read, write: if isAppClientOrStaff();
      match /{rest=**} {
        allow read, write: if isAppClientOrStaff();
      }
    }

    // Fallback data operasional top-level lainnya (brands, categories, customers, users, staff, ai_activity_logs, dsb.)
    match /{collection}/{docId} {
      allow read, write: if isAppClientOrStaff() && !serverOnly(collection) && collection != 'settings';
      match /{rest=**} {
        allow read, write: if isAppClientOrStaff() && !serverOnly(collection) && collection != 'stores';
      }
    }
  }
}
